ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME=Sahay-AI

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database URL: uses PostgreSQL or SQLite fallback for offline development
DATABASE_URL=sqlite:///./sahay_dev.db
DATABASE_ECHO=False

REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
