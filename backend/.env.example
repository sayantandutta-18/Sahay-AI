ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME=Sahay-AI

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://sahay-ai-beige.vercel.app

# Database URL: uses PostgreSQL or SQLite fallback for offline development
DATABASE_URL=sqlite:///./sahay_dev.db
DATABASE_ECHO=False

REDIS_URL=redis://localhost:6379/0

# Security & PII Encryption
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATA_ENCRYPTION_KEY=your_base64_32byte_fernet_key_here

# AI Engine Configuration
AI_MODE=auto
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MARKETAUX_API_KEY=your_marketaux_api_key_here
LLM_API_KEY=your_primary_llm_api_key_here
LLM_MODEL=gemini-2.5-flash
