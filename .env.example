# ==========================================
# SAHAY - Environment Configuration Example
# Copy to backend/.env and frontend/.env.local
# DO NOT commit real secrets to source control
# ==========================================

# Backend Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME=Sahay-AI

# Server Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL with pgvector)
# Use sqlite:///./sahay_dev.db for standalone local testing if PostgreSQL is not active
DATABASE_URL=postgresql+psycopg://sahay:sahay_dev_secret@localhost:5432/sahay_db
DATABASE_ECHO=False

# Redis Cache & Background Jobs
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production_32chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration (Set when testing Phase 6 / AI features)
LLM_PROVIDER=mock
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-2.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
